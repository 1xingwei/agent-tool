# 不同提供商的 API 密钥
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

# Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock 知识库 ID
AWS_KB_ID="<knowledge-base-id>"

# 使用假模型进行测试
USE_FAKE_MODEL=false

# 设置默认模型
DEFAULT_MODEL=

# 如果 MODEL 设置为 "openai-compatible"，请设置以下内容
# 这只是一个灵活的解决方案。如果需要多个模型选项，仍需将其添加到 models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web 服务器配置
HOST=0.0.0.0
PORT=8080

# 认证密钥，设置后需要 HTTP bearer token 头。
# WARNING: 如果未设置，所有 API 端点将不进行认证。在生产环境中务必设置此项。
AUTH_SECRET=

# 数据库配置
# 用于长期记忆和检查点的 SQLite store（按需在 var/ 下创建）
SQLITE_DB_PATH=var/checkpoints.db
SQLITE_STORE_PATH=var/memory_store.db

# Database_Search 工具使用的 RAG 向量数据库目录
CHROMA_DIR=./var/chroma_db

# Langsmith 配置
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 应用模式。如果值为 "dev"，将启用 uvicorn reload
MODE=

# 数据库类型。
# 如果值为 "postgres"，则需要 Postgresql 相关的环境变量。
# 如果值为 "sqlite"，则可以通过 SQLITE_DB_PATH 配置可选的文件路径
DATABASE_TYPE=

# 如果 DATABASE_TYPE=postgres
# Docker Compose 默认值（可与 docker-compose 配置配合使用）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# 你可以在 Postgres Connection Manager 中通过此 Application Name 识别 AST 连接
# POSTGRES_APPLICATION_NAME = "agent-service-toolkit"
# 设置这些值以自定义连接池中的连接数。Saver 和 store 拥有独立的连接池
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# 如果 DATABASE_TYPE=mongo
# 参见 docker/compose.mongo.yaml 以获取用于测试的本地 Mongo 容器
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false

# OpenWeatherMap API 密钥
OPENWEATHERMAP_API_KEY=

# 运行 ollama 时添加
# OLLAMA_MODEL=llama3.2
# 注意：如果在 docker 中运行服务而 ollama 在裸机上运行，请设置 OLLAMA_BASE_URL
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# 运行 Azure OpenAI 时添加
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5": "gpt-5-deployment", "gpt-5-mini": "gpt-5-mini-deployment"}

# Agent URL：用于 Streamlit 应用——如果未设置，默认为 http://{HOST}:{PORT}
# AGENT_URL=http://localhost:8080

# LANGFUSE 配置
#LANGFUSE_TRACING=true
#LANGFUSE_PUBLIC_KEY=pk-...
#LANGFUSE_SECRET_KEY=sk-lf-....
#LANGFUSE_HOST=http://localhost:3000

# GitHub MCP Agent 配置
# GitHub Personal Access Token（GitHub MCP server 必需）
# 如果未设置，GitHub MCP agent 将没有任何工具
GITHUB_PAT=

# 语音功能（可选）
# 注意：语音功能在客户端（Streamlit 应用）侧配置，而非服务端（API）。
# 需要设置 OPENAI_API_KEY（见上文）。
# 设置 provider 名称以启用语音输入/输出。留空则禁用。
# 目前仅支持 'openai'，且需要上文的 OPENAI_API_KEY。
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=
